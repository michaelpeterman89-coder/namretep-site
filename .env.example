# Copy this file to .env.local and fill in the values from your Supabase project:
# Supabase dashboard -> Project Settings -> API Keys (and Data API for the URL).
# Never commit .env.local.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (server only; never expose it to the browser or prefix it with NEXT_PUBLIC_).
SUPABASE_SECRET_KEY=
